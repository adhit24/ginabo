# ─────────────────────────────────────────────────────────────────────────────
# Ginabo — .env.local.example
# Copy to .env.local and fill in real values. Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://lvmyjtzfohlorocrjvcx.supabase.co
# anon/public key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only, bypasses RLS — keep secret
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret for custom token verification
SUPABASE_JWT_SECRET=

# ── Midtrans ──────────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Client key is also exposed to the browser (Snap.js)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Set to true when going live
MIDTRANS_IS_PRODUCTION=false

# ── Cloudflare R2 (media storage) ────────────────────────────────────────────
# Dashboard: R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ginabo-media
R2_ENDPOINT=https://123c47f0858d8f172331dcb94d15dcee.r2.cloudflarestorage.com
# Public bucket URL (custom domain or R2.dev subdomain)
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.ginabo.id

# ── Resend (transactional email) ──────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ginabo.id

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://ginabo.id
# Google OAuth: https://console.cloud.google.com → APIs & Services → Credentials
# Add Authorized redirect URI: https://ginabo.id/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# RajaOngkir API V2 / Komerce Shipping Cost
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_CITY_ID=15992

NEXT_PUBLIC_APP_URL=https://ginabo.id
# WhatsApp number in international format (no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=628xxxxxxxxxx
# Random secret used to authenticate cron job requests (openssl rand -hex 32)
CRON_SECRET=
ADMIN_EMAIL=admin@ginabo.id
